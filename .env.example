# Public Supabase config. These values are safe to expose to the Electron renderer
# only when Supabase RLS is correctly enforced.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_ASK_APP_BASE_URL=http://localhost:5173
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key

# Optional local development values.
# SUPABASE_PROJECT_REF=your-project-ref
# ASK_GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id

# Optional main-process AI provider config for local development. Do not prefix these with VITE_.
# ASK_AI_PROVIDER_API_KEY=your-provider-key
# ASK_AI_PROVIDER_MODEL=your-chat-completions-model
# ASK_AI_PROVIDER_URL=https://api.openai.com/v1/chat/completions
# ASK_AI_PROVIDER_TIMEOUT_MS=30000
